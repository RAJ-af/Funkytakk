<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for Android 12+ (API 31+).
   Tokens, private keys and local session credentials must NEVER be transferred to cloud or other devices.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude session tokens, authentication credentials and Tink encryption keys from cloud backup -->
        <exclude domain="sharedpref" path="funky_talk_prefs.xml"/>
        <exclude domain="sharedpref" path="e2ee_tink_prefs.xml"/>
        <exclude domain="sharedpref" path="vault_security_prefs.xml"/>
        <exclude domain="sharedpref" path="account_deletion_prefs.xml"/>
        <!-- Exclude encrypted local databases -->
        <exclude domain="database" path="."/>
    </cloud-backup>
    <device-transfer>
        <!-- Exclude session tokens and private Tink keys from device-to-device transfers -->
        <exclude domain="sharedpref" path="funky_talk_prefs.xml"/>
        <exclude domain="sharedpref" path="e2ee_tink_prefs.xml"/>
        <exclude domain="sharedpref" path="vault_security_prefs.xml"/>
        <exclude domain="sharedpref" path="account_deletion_prefs.xml"/>
        <exclude domain="database" path="."/>
    </device-transfer>
</data-extraction-rules>
