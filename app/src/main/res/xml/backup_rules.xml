<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android devices (pre-API 31 and fallback).
   Tokens, private keys and local session credentials must NEVER be backed up.
-->
<full-backup-content>
    <include domain="sharedpref" path="."/>
    <!-- Exclude session tokens, authentication credentials and Tink encryption keys -->
    <exclude domain="sharedpref" path="funky_talk_prefs.xml"/>
    <exclude domain="sharedpref" path="e2ee_tink_prefs.xml"/>
    <exclude domain="sharedpref" path="vault_security_prefs.xml"/>
    <exclude domain="sharedpref" path="account_deletion_prefs.xml"/>
    <!-- Exclude encrypted local databases -->
    <exclude domain="database" path="."/>
</full-backup-content>
