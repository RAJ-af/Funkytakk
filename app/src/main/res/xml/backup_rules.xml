<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android devices (pre-API 31 and fallback).
   android:allowBackup is false; exclude all domains so no app data is backed up.
-->
<full-backup-content>
    <exclude domain="root" path="."/>
    <exclude domain="file" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="external" path="."/>
</full-backup-content>
