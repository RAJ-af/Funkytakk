# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Firebase and Google Auth Production Credentials
# Configure these in the AI Studio Secrets Panel for production.
GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_APPLICATION_ID=YOUR_FIREBASE_APPLICATION_ID
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
# Supabase Config
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Custom Brevo Integration Cloud Endpoint (Firebase Cloud Function)
FUNKYTALK_BACKEND_URL=YOUR_FUNKYTALK_BACKEND_URL

# Direct Brevo Email Integration credentials
BREVO_API_KEY=YOUR_BREVO_API_KEY
BREVO_TEMPLATE_ID=4

